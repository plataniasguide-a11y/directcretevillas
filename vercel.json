<script>
// ── VILLA DATA — loaded from villas.json (same folder) ──
let allVillas = [];
let visibleCount = 6;
let activeRegion = '';

async function loadVillas() {
  try {
    const r = await fetch('villas.json');
    allVillas = await r.json();
  } catch {
    allVillas = getSampleVillas();
  }
  animateCount(allVillas.length);
  updateRegionCounts();
  renderVillas();
}

function getSampleVillas() {
  return [
    {id:1,name:"Villa Eleni",region:"Heraklion",area:"Agia Pelagia",persons:8,price:220,pool:true,seaview:true,photo:"https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=600&q=70",phone:"+30 699 900 9499",description:"Stunning villa with private pool and panoramic sea views."},
    {id:2,name:"Villa Zorbas",region:"Chania",area:"Platanias",persons:6,price:180,pool:true,seaview:false,photo:"https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=600&q=70",phone:"+30 699 900 9499",description:"Charming villa in the heart of Platanias with lush garden."},
    {id:3,name:"Villa Ariadne",region:"Rethymno",area:"Panormo",persons:10,price:310,pool:true,seaview:true,photo:"https://images.unsplash.com/photo-1602343168117-bb8ffe3e2e9f?w=600&q=70",phone:"+30 699 900 9499",description:"Grand villa for large groups with breathtaking views."},
    {id:4,name:"Villa Daedalus",region:"Lasithi",area:"Elounda",persons:4,price:150,pool:false,seaview:true,photo:"https://images.unsplash.com/photo-1570197788417-0e82375c9371?w=600&q=70",phone:"+30 699 900 9499",description:"Cozy villa near Elounda with amazing sea views."},
    {id:5,name:"Villa Aphrodite",region:"Heraklion",area:"Hersonissos",persons:6,price:190,pool:true,seaview:false,photo:"https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=600&q=70",phone:"+30 699 900 9499",description:"Modern villa minutes from the beach."},
    {id:6,name:"Villa Poseidon",region:"Chania",area:"Kissamos",persons:8,price:240,pool:true,seaview:true,photo:"https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=600&q=70",phone:"+30 699 900 9499",description:"Seafront villa with direct beach access."}
  ];
}

function animateCount(target) {
  let n = 0;
  const el = document.getElementById('cnt-villas');
  const step = Math.ceil(target / 40);
  const t = setInterval(() => {
    n = Math.min(n + step, target);
    el.textContent = n;
    if (n >= target) clearInterval(t);
  }, 30);
}

function updateRegionCounts() {
  const counts = {Heraklion:0,Chania:0,Rethymno:0,Lasithi:0};
  allVillas.forEach(v => { if (counts[v.region] !== undefined) counts[v.region]++; });
  const set = (id, r) => { const el = document.getElementById(id); if(el) el.textContent = counts[r] + ' villas'; };
  set('cnt-h','Heraklion'); set('cnt-ch','Chania'); set('cnt-r','Rethymno'); set('cnt-l','Lasithi');
}

function filterVillas() {
  activeRegion = document.getElementById('filter-region').value;
  const guests = parseInt(document.getElementById('filter-guests').value) || 0;
  document.querySelectorAll('.pill').forEach(p => {
    p.classList.toggle('active', p.dataset.region === activeRegion);
  });
  visibleCount = 6;
  renderVillas(guests);
}

function setPill(el, region) {
  activeRegion = region;
  document.getElementById('filter-region').value = region;
  document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
  visibleCount = 6;
  renderVillas();
}

function renderVillas(guestMin = 0) {
  let filtered = allVillas.filter(v => {
    if (activeRegion && v.region !== activeRegion) return false;
    if (guestMin && v.persons < guestMin) return false;
    return true;
  });
  const label = document.getElementById('villa-count-label');
  label.textContent = filtered.length + ' villas available for direct booking';
  const grid = document.getElementById('villa-grid');
  const shown = filtered.slice(0, visibleCount);
  grid.innerHTML = shown.map(v => `
    <div class="vcard" onclick="openModal('${v.name}')">
      <div class="vcard-img" style="background-image:url('${v.photo}')">
        <span class="vcard-badge">${v.region}</span>
        <button class="vcard-fav" onclick="event.stopPropagation()">♡</button>
      </div>
      <div class="vcard-body">
        <div class="vcard-region">${v.region} · ${v.area || ''}</div>
        <div class="vcard-name">${v.name}</div>
        <div class="vcard-meta">
          <span>👥 ${v.persons} persons</span>
          ${v.pool ? '<span>🏊 Pool</span>' : ''}
          ${v.seaview ? '<span>🌊 Sea view</span>' : ''}
        </div>
        <div class="vcard-footer">
          <div class="vcard-price">${v.price ? '<strong>€'+v.price+'</strong>/night' : '<strong>On request</strong>'}</div>
          <button class="btn-inq" onclick="event.stopPropagation();openModal('${v.name}')">Inquire Now</button>
        </div>
      </div>
    </div>
  `).join('');
}

function showAllVillas() {
  visibleCount = 9999;
  renderVillas();
}

let currentVilla = '';
function openModal(villa) {
  currentVilla = villa;
  document.getElementById('modal').classList.add('open');
  document.getElementById('modal-villa-lbl').textContent = villa === 'any'
    ? 'Send your inquiry — we reply within 24 hours'
    : 'Inquiry for: ' + villa;
  document.getElementById('modal-form-wrap').style.display = '';
  document.getElementById('modal-success').style.display = 'none';
}
function closeModal(e) {
  if (!e || e.target === document.getElementById('modal'))
    document.getElementById('modal').classList.remove('open');
}

function submitInquiry() {
  const email = document.getElementById('m-email').value;
  if (!email) { alert('Please enter your email address.'); return; }
  document.getElementById('modal-form-wrap').style.display = 'none';
  document.getElementById('modal-success').style.display = 'block';
  document.getElementById('success-email').textContent = email;
  // In production: send to backend/email here
  const subject = encodeURIComponent('Villa Inquiry: ' + currentVilla);
  const fname = document.getElementById('m-fname').value;
  const lname = document.getElementById('m-lname').value;
  const phone = document.getElementById('m-phone').value;
  const checkin = document.getElementById('m-checkin').value;
  const checkout = document.getElementById('m-checkout').value;
  const guests = document.getElementById('m-guests').value;
  const msg = document.getElementById('m-msg').value;
  const body = encodeURIComponent(`Villa: ${currentVilla}\nName: ${fname} ${lname}\nEmail: ${email}\nPhone: ${phone}\nCheck-in: ${checkin}\nCheck-out: ${checkout}\nGuests: ${guests}\nMessage: ${msg}`);
  window.location.href = `mailto:plataniasguide@gmail.com?subject=${subject}&body=${body}`;
}

// Pill data attributes
document.querySelectorAll('.pill').forEach((p, i) => {
  const regions = ['','Heraklion','Chania','Rethymno','Lasithi'];
  p.dataset.region = regions[i] || '';
});

// Loading screen
window.addEventListener('load', () => {
  setTimeout(() => document.getElementById('loading').classList.add('hide'), 1200);
});

loadVillas();
</script>
</body>
</html>
