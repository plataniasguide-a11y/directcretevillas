    <a href="https://wa.me/306999009499" target="_blank" class="c-btn c-btn-outline">💬 WhatsApp</a>
  </div>
</div>

<!-- INQUIRY MODAL -->
<div class="modal-bg" id="modal" onclick="closeModal(event)">
  <div class="modal">
    <button class="modal-close" onclick="closeModal()">×</button>
    <div id="modal-form-wrap">
      <h3>Book Direct</h3>
      <div class="modal-sub" id="modal-villa-lbl">Send your inquiry — we reply within 24 hours</div>
      <div class="frow">
        <div class="fg"><label>First name</label><input type="text" id="m-fname" placeholder="John"></div>
        <div class="fg"><label>Last name</label><input type="text" id="m-lname" placeholder="Smith"></div>
      </div>
      <div class="fg"><label>Email</label><input type="email" id="m-email" placeholder="john@email.com"></div>
      <div class="fg"><label>Phone / WhatsApp</label><input type="tel" id="m-phone" placeholder="+44 7700..."></div>
      <div class="frow">
        <div class="fg"><label>Check-in</label><input type="date" id="m-checkin"></div>
        <div class="fg"><label>Check-out</label><input type="date" id="m-checkout"></div>
      </div>
      <div class="fg">
        <label>Guests</label>
        <select id="m-guests">
          <option>2 guests</option><option>3 guests</option><option>4 guests</option>
          <option>6 guests</option><option>8 guests</option><option>10+ guests</option>
        </select>
      </div>
      <div class="fg"><label>Message</label><textarea id="m-msg" placeholder="Any special requests, questions about the villa..."></textarea></div>
      <button class="btn-submit" onclick="submitInquiry()">Send Direct Inquiry →</button>
    </div>
    <div class="success-msg" id="modal-success">
      <div class="check">✅</div>
      <h4>Inquiry Sent!</h4>
      <p>Thank you! We will contact you at <strong id="success-email"></strong> within 24 hours.<br><br>
      Or call us directly: <a href="tel:+306999009499" style="color:var(--navy)">+30 699 900 9499</a></p>
    </div>
  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="fl">Direct<span>Crete</span>Villas</div>
      <p>Book luxury villas in Crete directly from owners. No commission, no hidden fees — just the best price and personal service.</p>
      <div style="margin-top:1rem;font-size:13px">
        📧 <a href="mailto:plataniasguide@gmail.com" style="color:var(--gold-light)">plataniasguide@gmail.com</a><br>
        📞 <a href="tel:+306999009499" style="color:var(--gold-light)">+30 699 900 9499</a>
      </div>
    </div>
