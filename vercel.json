      <button class="pill" onclick="setPill(this,'Lasithi')">Lasithi</button>
    </div>
  </div>
  <div class="villa-grid" id="villa-grid"></div>
  <button class="btn-view-all" onclick="showAllVillas()">View All Villas →</button>
</section>

<!-- WHY DIRECT -->
<section class="why-section" id="why">
  <div class="why-inner">
    <div class="why-text">
      <h2>Why book<br><em>directly with us?</em></h2>
      <p>Skip Airbnb, Booking.com and the 15–20% service fees. When you contact us directly, you get the best price — guaranteed — plus personal service from someone who knows every villa on this island.</p>
      <a href="tel:+306999009499" style="display:inline-block;background:var(--navy);color:white;padding:12px 28px;border-radius:6px;font-size:14px;font-weight:500">Call Us: +30 699 900 9499</a>
    </div>
    <div class="why-points">
      <div class="why-point"><div class="wp-num">0%</div><div class="wp-label">Commission or hidden fees</div></div>
      <div class="why-point"><div class="wp-num">20%</div><div class="wp-label">Average savings vs Airbnb</div></div>
      <div class="why-point"><div class="wp-num">100+</div><div class="wp-label">Verified villas on Crete</div></div>
      <div class="why-point"><div class="wp-num">24h</div><div class="wp-label">Guaranteed response time</div></div>
    </div>
  </div>
</section>

<!-- REGIONS -->
<section class="section" id="regions">
  <div class="section-title">Explore by <em>Region</em></div>
  <div class="regions-grid">
    <div class="region-card" onclick="setPill(document.querySelector('.pill'),'Heraklion');document.getElementById('villas').scrollIntoView()">
      <img src="https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=500&q=70" alt="Villas in Heraklion Crete" loading="lazy">
      <div class="region-overlay"><div class="region-name">Heraklion<span class="region-count" id="cnt-h"></span></div></div>
    </div>
    <div class="region-card" onclick="setPill(document.querySelectorAll('.pill')[2],'Chania');document.getElementById('villas').scrollIntoView()">
      <img src="https://images.unsplash.com/photo-1602343168117-bb8ffe3e2e9f?w=500&q=70" alt="Villas in Chania Crete" loading="lazy">
      <div class="region-overlay"><div class="region-name">Chania<span class="region-count" id="cnt-ch"></span></div></div>
    </div>
    <div class="region-card" onclick="setPill(document.querySelectorAll('.pill')[3],'Rethymno');document.getElementById('villas').scrollIntoView()">
      <img src="https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=500&q=70" alt="Villas in Rethymno Crete" loading="lazy">
      <div class="region-overlay"><div class="region-name">Rethymno<span class="region-count" id="cnt-r"></span></div></div>
    </div>
    <div class="region-card" onclick="setPill(document.querySelectorAll('.pill')[4],'Lasithi');document.getElementById('villas').scrollIntoView()">
      <img src="https://images.unsplash.com/photo-1570197788417-0e82375c9371?w=500&q=70" alt="Villas in Lasithi Crete" loading="lazy">
      <div class="region-overlay"><div class="region-name">Lasithi<span class="region-count" id="cnt-l"></span></div></div>
    </div>
  </div>
</section>

<!-- CONTACT STRIP -->
<div class="contact-strip">
  <h2>Ready to Book Your Dream Villa?</h2>
  <p>Contact us directly — no fees, no waiting, personal service</p>
  <div class="contact-btns">
