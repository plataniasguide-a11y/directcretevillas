<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Direct Crete Villas – Rent Direct from Owners | No Airbnb Fees</title>
<meta name="description" content="Rent luxury villas in Crete directly from owners. No Airbnb commission. Best prices in Heraklion, Chania, Rethymno, Lasithi. Private pools, sea views, families welcome.">
<meta name="keywords" content="villa crete rent, villa heraklion, villa chania, villa rethymno, crete holiday villa, rent villa crete direct owner, no airbnb fees crete villa">
<meta property="og:title" content="Direct Crete Villas – Book Direct, Save More">
<meta property="og:description" content="100+ handpicked villas across Crete. Book directly with owners and save up to 20%.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://www.directcretevillas.com">
<link rel="canonical" href="https://www.directcretevillas.com">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": "Direct Crete Villas",
  "description": "Luxury villa rentals in Crete. Book direct from owners.",
  "url": "https://www.directcretevillas.com",
  "telephone": "+306999009499",
  "email": "plataniasguide@gmail.com",
  "address": {"@type": "PostalAddress", "addressCountry": "GR", "addressRegion": "Crete"}
}
</script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --navy:#0D2B45;
  --navy2:#1A4A6E;
  --gold:#C9974A;
  --gold-light:#F0C875;
  --sand:#F7F2E8;
  --sand2:#EDE6D6;
  --terra:#B85C38;
  --white:#FEFCF8;
  --text:#1A1209;
  --muted:#7A6E60;
  --border:rgba(13,43,69,0.12);
  --radius:10px;
}
body{font-family:'DM Sans',sans-serif;background:var(--white);color:var(--text);font-size:15px;line-height:1.6}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}

/* NAV */
nav{position:sticky;top:0;z-index:200;background:var(--navy);padding:0 2rem;height:62px;display:flex;align-items:center;justify-content:space-between}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:20px;color:white;letter-spacing:0.3px}
.nav-logo span{color:var(--gold-light)}
.nav-links{display:flex;gap:1.8rem;align-items:center}
.nav-links a{color:rgba(255,255,255,0.8);font-size:13px;font-weight:300;letter-spacing:0.3px;transition:color .2s}
.nav-links a:hover{color:var(--gold-light)}
.nav-cta{background:var(--gold);color:var(--navy);padding:8px 20px;border-radius:5px;font-size:13px;font-weight:500;cursor:pointer;border:none;font-family:'DM Sans',sans-serif;transition:background .2s}
.nav-cta:hover{background:var(--gold-light)}
.nav-phone{color:var(--gold-light)!important;font-weight:500!important}

/* HERO */
.hero{min-height:88vh;background:var(--navy);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:4rem 2rem;position:relative;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=1600&q=70') center/cover;opacity:0.18}
.hero-content{position:relative;z-index:1;max-width:780px}
.hero-eyebrow{color:var(--gold-light);font-size:11px;letter-spacing:3px;text-transform:uppercase;margin-bottom:1.2rem;font-weight:400}
.hero h1{font-family:'Cormorant Garamond',serif;font-size:clamp(42px,6vw,72px);color:white;line-height:1.1;margin-bottom:1.2rem;font-weight:400}
.hero h1 em{color:var(--gold-light);font-style:italic}
.hero-sub{color:rgba(255,255,255,0.7);font-size:17px;font-weight:300;max-width:520px;margin:0 auto 2.5rem;line-height:1.7}
.hero-stats{display:flex;gap:3rem;justify-content:center;margin-bottom:3rem}
.hero-stat .num{font-family:'Cormorant Garamond',serif;font-size:36px;color:var(--gold-light);line-height:1}
.hero-stat .lbl{font-size:12px;color:rgba(255,255,255,0.5);margin-top:4px;letter-spacing:0.5px}

/* SEARCH */
.search-wrap{background:white;border-radius:var(--radius);display:flex;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.25);max-width:700px;width:100%;margin:0 auto}
.sg{flex:1;padding:14px 18px;border-right:1px solid #EDE6D0}
.sg:last-of-type{border-right:none}
.sg label{display:block;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.sg select,.sg input{border:none;outline:none;font-family:'DM Sans',sans-serif;font-size:14px;color:var(--text);background:transparent;width:100%}
.search-btn{background:var(--terra);color:white;border:none;padding:0 28px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;cursor:pointer;letter-spacing:0.3px;transition:background .2s}
.search-btn:hover{background:#9E4D2E}

/* TRUST BAR */
.trust-bar{background:var(--sand);padding:1rem 2rem;display:flex;justify-content:center;gap:3rem;flex-wrap:wrap}
.trust-item{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted)}
.trust-item svg{color:var(--gold);flex-shrink:0}

/* SECTION */
.section{max-width:1240px;margin:0 auto;padding:4rem 2rem}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2.5rem;flex-wrap:wrap;gap:1rem}
.section-title{font-family:'Cormorant Garamond',serif;font-size:38px;font-weight:400}
.section-title em{color:var(--navy2);font-style:italic}
.section-sub{font-size:13px;color:var(--muted)}
.filter-row{display:flex;gap:8px;flex-wrap:wrap}
.pill{padding:6px 18px;border-radius:20px;border:1px solid var(--border);font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif;background:white;color:var(--muted);transition:all .2s}
.pill.active,.pill:hover{background:var(--navy);color:white;border-color:var(--navy)}

/* VILLA GRID */
.villa-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:28px}
.vcard{background:white;border-radius:14px;overflow:hidden;border:1px solid rgba(0,0,0,0.07);transition:transform .25s,box-shadow .25s;cursor:pointer}
.vcard:hover{transform:translateY(-5px);box-shadow:0 16px 40px rgba(13,43,69,0.13)}
.vcard-img{height:230px;background:var(--sand2) center/cover no-repeat;position:relative}
.vcard-badge{position:absolute;top:14px;left:14px;background:var(--navy);color:white;font-size:11px;letter-spacing:1px;text-transform:uppercase;padding:4px 11px;border-radius:4px}
.vcard-fav{position:absolute;top:14px;right:14px;background:white;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:none;cursor:pointer;font-size:17px;box-shadow:0 2px 8px rgba(0,0,0,0.12);transition:transform .2s}
.vcard-fav:hover{transform:scale(1.15)}
.vcard-body{padding:1.4rem}
.vcard-region{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--terra);margin-bottom:5px;font-weight:500}
.vcard-name{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:400;margin-bottom:8px}
.vcard-meta{display:flex;gap:14px;font-size:13px;color:var(--muted);margin-bottom:14px;flex-wrap:wrap}
.vcard-footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--sand2);padding-top:14px}
.vcard-price{font-size:13px;color:var(--muted)}
.vcard-price strong{font-family:'Cormorant Garamond',serif;font-size:26px;color:var(--navy);font-weight:600;margin-right:2px}
.btn-inq{background:var(--navy);color:white;border:none;padding:9px 20px;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:13px;cursor:pointer;transition:background .2s}
.btn-inq:hover{background:var(--navy2)}
.btn-view-all{display:block;margin:2.5rem auto 0;background:transparent;border:1.5px solid var(--navy);color:var(--navy);padding:12px 36px;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:14px;cursor:pointer;transition:all .2s}
.btn-view-all:hover{background:var(--navy);color:white}

/* WHY DIRECT */
.why-section{background:var(--sand);padding:5rem 2rem}
.why-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
.why-text h2{font-family:'Cormorant Garamond',serif;font-size:42px;font-weight:400;line-height:1.15;margin-bottom:1rem}
.why-text p{font-size:15px;color:var(--muted);font-weight:300;line-height:1.8;margin-bottom:2rem}
.why-points{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.why-point{background:white;border-radius:var(--radius);padding:1.2rem;border:1px solid var(--border)}
.why-point .wp-num{font-family:'Cormorant Garamond',serif;font-size:32px;color:var(--terra);line-height:1}
.why-point .wp-label{font-size:13px;color:var(--muted);margin-top:4px}

/* REGIONS */
.regions-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:2rem}
.region-card{border-radius:12px;overflow:hidden;position:relative;height:200px;cursor:pointer}
.region-card img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
.region-card:hover img{transform:scale(1.05)}
.region-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(13,43,69,0.75) 0%,transparent 60%);display:flex;align-items:flex-end;padding:1.2rem}
.region-name{font-family:'Cormorant Garamond',serif;color:white;font-size:22px;font-weight:400}
.region-count{font-size:12px;color:rgba(255,255,255,0.7);display:block}

/* CONTACT STRIP */
.contact-strip{background:var(--navy);padding:3rem 2rem;text-align:center}
.contact-strip h2{font-family:'Cormorant Garamond',serif;font-size:36px;color:white;margin-bottom:8px;font-weight:400}
.contact-strip p{color:rgba(255,255,255,0.6);font-size:14px;font-weight:300;margin-bottom:1.5rem}
.contact-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.c-btn{padding:12px 28px;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;cursor:pointer;transition:all .2s;border:none}
.c-btn-primary{background:var(--gold);color:var(--navy)}
.c-btn-primary:hover{background:var(--gold-light)}
.c-btn-outline{background:transparent;color:white;border:1px solid rgba(255,255,255,0.4)}
.c-btn-outline:hover{border-color:white;background:rgba(255,255,255,0.08)}

/* MODAL */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:500;align-items:center;justify-content:center;padding:1rem}
.modal-bg.open{display:flex}
.modal{background:white;border-radius:16px;padding:2.5rem;width:100%;max-width:520px;position:relative;max-height:90vh;overflow-y:auto}
.modal-close{position:absolute;top:16px;right:18px;background:none;border:none;font-size:24px;cursor:pointer;color:var(--muted);line-height:1}
.modal h3{font-family:'Cormorant Garamond',serif;font-size:26px;margin-bottom:4px;font-weight:400}
.modal-sub{font-size:13px;color:var(--muted);margin-bottom:1.5rem}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.fg{margin-bottom:12px}
.fg label{display:block;font-size:11px;letter-spacing:0.5px;color:var(--muted);margin-bottom:6px;text-transform:uppercase}
.fg input,.fg select,.fg textarea{width:100%;padding:10px 14px;border:1px solid #DDD6C8;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:14px;color:var(--text);outline:none;transition:border-color .2s}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--navy2)}
.fg textarea{height:80px;resize:vertical}
.btn-submit{width:100%;background:var(--navy);color:white;border:none;padding:14px;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:15px;font-weight:500;cursor:pointer;margin-top:8px;transition:background .2s}
.btn-submit:hover{background:var(--navy2)}
.success-msg{display:none;text-align:center;padding:1rem}
.success-msg .check{font-size:48px;margin-bottom:1rem}
.success-msg h4{font-family:'Cormorant Garamond',serif;font-size:24px;margin-bottom:8px}
.success-msg p{font-size:14px;color:var(--muted)}

/* FOOTER */
footer{background:#09192A;padding:3rem 2rem 1.5rem;color:rgba(255,255,255,0.5)}
.footer-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:3rem;margin-bottom:2rem}
.footer-brand .fl{font-family:'Cormorant Garamond',serif;font-size:20px;color:white;margin-bottom:8px}
.footer-brand .fl span{color:var(--gold-light)}
.footer-brand p{font-size:13px;line-height:1.7;font-weight:300}
footer h4{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:1rem;font-weight:400}
footer ul{list-style:none}
footer ul li{margin-bottom:8px}
footer ul li a{font-size:13px;color:rgba(255,255,255,0.5);transition:color .2s;font-weight:300}
footer ul li a:hover{color:var(--gold-light)}
.footer-bottom{border-top:1px solid rgba(255,255,255,0.08);padding-top:1.2rem;display:flex;justify-content:space-between;align-items:center;font-size:12px}

/* LOADING */
#loading{position:fixed;inset:0;background:var(--navy);z-index:9999;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;transition:opacity .5s}
#loading.hide{opacity:0;pointer-events:none}
#loading .ll{font-family:'Cormorant Garamond',serif;font-size:28px;color:white}
#loading .ll span{color:var(--gold-light)}
#loading .bar{width:160px;height:2px;background:rgba(255,255,255,0.15);border-radius:2px;overflow:hidden}
#loading .bar-fill{height:100%;background:var(--gold);border-radius:2px;animation:load 1.2s ease forwards}
@keyframes load{from{width:0}to{width:100%}}

@media(max-width:768px){
  .why-inner{grid-template-columns:1fr}
  .regions-grid{grid-template-columns:1fr 1fr}
  .footer-inner{grid-template-columns:1fr 1fr}
  .frow{grid-template-columns:1fr}
  .hero-stats{gap:1.5rem}
  .nav-links{display:none}
}
</style>
</head>
<body>

<div id="loading">
  <div class="ll">Direct<span>Crete</span>Villas</div>
  <div class="bar"><div class="bar-fill"></div></div>
</div>

<!-- NAV -->
<nav>
  <div class="nav-logo">Direct<span>Crete</span>Villas</div>
  <div class="nav-links">
    <a href="#villas">Villas</a>
    <a href="#regions">Regions</a>
    <a href="#why">Why Direct</a>
    <a href="tel:+306999009499" class="nav-phone">📞 +30 699 900 9499</a>
  </div>
  <button class="nav-cta" onclick="openModal('any')">Book Direct</button>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">Crete Island, Greece — 100+ Villas</div>
    <h1>Rent Direct.<br><em>No Airbnb Fees.</em><br>Best Price Guaranteed.</h1>
    <p class="hero-sub">Handpicked luxury villas across Crete. Contact owners directly and save up to 20% on every stay.</p>
    <div class="hero-stats">
      <div class="hero-stat"><div class="num" id="cnt-villas">0</div><div class="lbl">Villas</div></div>
      <div class="hero-stat"><div class="num">4</div><div class="lbl">Regions</div></div>
      <div class="hero-stat"><div class="num">0%</div><div class="lbl">Commission</div></div>
      <div class="hero-stat"><div class="num">24h</div><div class="lbl">Response</div></div>
    </div>
    <div class="search-wrap">
      <div class="sg">
        <label>Region</label>
        <select id="filter-region" onchange="filterVillas()">
          <option value="">All Regions</option>
          <option value="Heraklion">Heraklion</option>
          <option value="Chania">Chania</option>
          <option value="Rethymno">Rethymno</option>
          <option value="Lasithi">Lasithi</option>
        </select>
      </div>
      <div class="sg">
        <label>Guests</label>
        <select id="filter-guests" onchange="filterVillas()">
          <option value="">Any</option>
          <option value="2">2+</option>
          <option value="4">4+</option>
          <option value="6">6+</option>
          <option value="8">8+</option>
          <option value="10">10+</option>
        </select>
      </div>
      <div class="sg">
        <label>Check-in</label>
        <input type="date" id="checkin">
      </div>
      <button class="search-btn" onclick="filterVillas()">Search</button>
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust-bar">
  <div class="trust-item">
    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
    Book direct — no middleman
  </div>
  <div class="trust-item">
    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    Save up to 20% vs Airbnb
  </div>
  <div class="trust-item">
    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
    Reply within 24 hours
  </div>
  <div class="trust-item">
    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    Heraklion · Chania · Rethymno · Lasithi
  </div>
</div>

<!-- VILLAS -->
<section class="section" id="villas">
  <div class="section-head">
    <div>
      <div class="section-title">Our <em>Villas</em></div>
      <div class="section-sub" id="villa-count-label">Loading villas…</div>
    </div>
    <div class="filter-row">
      <button class="pill active" onclick="setPill(this,'')">All</button>
      <button class="pill" onclick="setPill(this,'Heraklion')">Heraklion</button>
      <button class="pill" onclick="setPill(this,'Chania')">Chania</button>
